# --- Supabase (Project settings > API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" / publishable key. Safe to expose: RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key. SERVER ONLY (API routes + scripts). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Boda / client login ------------------------------------------------------
# Long random secret (>= 32 chars). Used to derive the Supabase password from
# phone + PIN, so a 4-digit PIN never is the password itself.
#   openssl rand -hex 32
# DO NOT CHANGE after users exist (they could no longer sign in).
AUTH_PEPPER=

# --- Optional -----------------------------------------------------------------
# Public URL of the site (used in the README seed output only).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
