{
  "name": "boda-kilgoris",
  "version": "0.1.0",
  "private": true,
  "description": "Local ride-hailing PWA for motorbike taxis (Bodas) in Kilgoris, Kenya",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run i18n:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:review": "node scripts/export-sw-review.mjs",
    "test:db": "node supabase/tests/state-machine.test.mjs",
    "seed": "node scripts/seed.mjs",
    "simulate": "node scripts/simulate.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "test:unit": "node --test src/lib/phone.test.ts",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
